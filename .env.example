# Server Configuration
NODE_ENV=development
PORT=5000
# FRONTEND_URL can be a single URL, a comma-separated list of URLs, or '*' to dynamically allow any origin (useful for hosting providers)
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/robomiracle

# Security Configuration
JWT_SECRET=your_secure_secret_key_here
JWT_EXPIRE=7d

# Upload Configuration
UPLOAD_SIZE_LIMIT=5242880 # 5MB in bytes
ALLOWED_MIMETYPES=image/jpeg,image/png,image/gif,image/webp

# Default Business/Company Values (Optional Softcodes)
